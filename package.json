{
  "name": "@local/dsh-plugin-image2",
  "version": "1.7.0",
  "private": true,
  "description": "Image studio: save an image-API endpoint and key for this profile, then generate pictures from a prompt in the Web UI — with optional reference pictures that turn a run into an image-to-image edit — or from the image2_generate tool.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mr-Maidong/dsh-plugin-image2.git"
  },
  "homepage": "https://github.com/Mr-Maidong/dsh-plugin-image2#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "image-generation"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
